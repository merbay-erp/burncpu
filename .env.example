# burncpu development env
# Copy to .env and adjust for local development.
# Production values live in /opt/burncpu/.env (systemd EnvironmentFile).

BIND_ADDR=127.0.0.1:3050
DATABASE_URL=postgres://burncpu:CHANGE_ME@127.0.0.1:5433/burncpu
REDIS_URL=redis://127.0.0.1:6380
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=
SITE_ORIGIN=http://localhost:3050
RUST_LOG=burncpu=debug,tower_http=info

# burncpu — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and adjust for local development. Production values live in
# /opt/burncpu/.env (systemd EnvironmentFile, chmod 600, root-owned).
# Full reference: docs/CONFIGURATION.md
#
# Required to boot: DATABASE_URL. For admin 2FA you also need BURNCPU_ENC_KEY.
# Everything else has a sensible default or is feature-gated.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────
BIND_ADDR=127.0.0.1:3050
DATABASE_URL=postgres://burncpu:CHANGE_ME@127.0.0.1:5433/burncpu
REDIS_URL=redis://127.0.0.1:6380
SITE_ORIGIN=http://localhost:3050
# tracing-subscriber filter (per-crate levels)
RUST_LOG=burncpu=debug,tower_http=info

# ── Search (Meilisearch) ──────────────────────────────────────────
MEILISEARCH_URL=http://127.0.0.1:7700
# Master key (MEILI_MASTER_KEY takes precedence; MEILISEARCH_KEY also accepted).
# Leave empty for a keyless local dev instance.
MEILI_MASTER_KEY=

# ── Crypto ────────────────────────────────────────────────────────
# 32-byte key (64 hex chars) used to encrypt stored TOTP secrets at rest.
# Required for admin 2FA. Generate: `openssl rand -hex 32`
BURNCPU_ENC_KEY=

# ── Accounts ──────────────────────────────────────────────────────
# Require an invite code to sign up: 1/true/yes/on (default: off).
INVITES_REQUIRED=false
# Email that is auto-promoted to admin on first sign-in (optional).
BOOTSTRAP_ADMIN_EMAIL=
# Comma-separated extra CORS origins (beyond SITE_ORIGIN). Usually empty.
ALLOWED_ORIGINS=

# ── Media ─────────────────────────────────────────────────────────
# Directory for uploaded images (EXIF-stripped, re-encoded). Must be writable.
MEDIA_DIR=/data/media

# ── Email ─────────────────────────────────────────────────────────
# Unset (or anything but "smtp") → console backend: magic links are written to
# the tracing logs only. Perfect for local dev — no SMTP needed.
# Set to "smtp" to send real mail (then SMTP_* below are required).
EMAIL_BACKEND=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be a valid mailbox, e.g. "burncpu <hi@burncpu.com>"
SMTP_FROM=
# STARTTLS on by default; set 0/false/no/off for implicit TLS (port 465).
SMTP_STARTTLS=true

# ── Web Push (optional) ───────────────────────────────────────────
# VAPID keypair for browser push notifications. Generate with a VAPID tool.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hi@burncpu.com

# ── Federation (optional, flag-gated) ─────────────────────────────
# ActivityPub server-to-server. Off by default — single-instance first.
FEDERATION_ENABLED=false

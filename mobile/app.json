{
  "expo": {
    "name": "burncpu",
    "slug": "burncpu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "burncpu",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#171311",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.burncpu.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:burncpu.com",
        "webcredentials:burncpu.com"
      ]
    },
    "android": {
      "package": "com.burncpu.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#171311",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "burncpu.com",
              "pathPrefix": "/auth/verify"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "resizeMode": "contain",
          "backgroundColor": "#171311",
          "dark": {
            "backgroundColor": "#171311"
          }
        }
      ],
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "color": "#ff8a3c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ad9565e-90b6-460a-8e6f-a3eb450da8ea"
      }
    },
    "owner": "mustafaerbay"
  }
}
